{
  "comments": { "lineComment": "//" },
  "brackets": [["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?!//).*:\\s*(//.*)?$",
    "decreaseIndentPattern": "^\\s*(end\\b|else\\b|case\\b|handler\\b|fn\\b(?=.*:\\s*$))"
  },
  "onEnterRules": [
    { "beforeText": "^\\s*(?!//).*:\\s*$", "action": { "indent": "indent" } }
  ],
  "wordPattern": "(\\$?[A-Za-z_][A-Za-z0-9_]*)|(~?-?\\d[\\d_]*(\\.\\d[\\d_]*)?)"
}
