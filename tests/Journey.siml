// The oracle's tests: each .jern file is its own program (D122).
name tests
ver 2026y-11m-14d not_broken
kind tests

need std 2026y-11m-14d

// Only for another build mode, so the oracle skips it (D111).
mode.Working rule unused.variable warn

d60_use_gives_a_short_name.jern:
use geometry.area as area
use greet.loud as "shout"
end d60_use_gives_a_short_name.jern
