fn show[$label: String, $i: Int]:
    println($label " " $i as String)
end fn show

fn.main[]:
    for $i in range[from: 1, to: 5]:
        show("to", $i)
    end for
    for $i in range[from: 0, before: 5]:
        show("before", $i)
    end for
    for $i in range[from: 0, to: 10, step_by: 2]:
        show("step", $i)
    end for
    for $i in range[from: 5, to: 1, step_by: -1]:
        show("down", $i)
    end for
end fn.main
