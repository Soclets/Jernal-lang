fam.fn area:
    versions area:
        [$side: Int] -> Int:
            return $side x $side
        end version
        [$w: Int, $h: Int] -> Int:
            return $w x $h
        end version
        [$w: Float, $h: Float, $scale: Float] -> Float:
            return $w x $h x $scale
        end version
    end versions area
end fam.fn area

fn.main[]:
    println(area(3) as String)
    println(area(3, 4) as String)
    let $r: Float = 2.5
    println(area($r, $r, $r) as String)
end fn.main
