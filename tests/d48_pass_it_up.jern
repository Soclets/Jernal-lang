fn half[$n: Int] -> Int fails [odd]:
    if $n mod.trunc 2 != 0:
        fail odd
    end if
    return $n div.trunc 2
end fn half

fn quarter[$n: Int] -> Int fails [odd]:
    let $h: Int = half($n)?
    return half($h)?
end fn quarter

fn.main[]:
    println((quarter(8) ?? 0) as String)
    println((quarter(6) ?? 0) as String)
end fn.main
