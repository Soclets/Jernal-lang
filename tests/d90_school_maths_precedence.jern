fn.main[]:
    let $a: Int = 2 + 3 x 4
    let $b: Int = (2 + 3) x 4
    let $c: Int = 10 - 2 - 3
    let $d: Int = -2 x 3
    let $e: Int = 20 div.trunc 2 x 5
    println($a as String)
    println($b as String)
    println($c as String)
    println($d as String)
    println($e as String)
end fn.main
