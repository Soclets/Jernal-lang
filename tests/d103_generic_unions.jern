union.tagged Maybe<?Item: Any>:
    nothing
    some[value: ?Item]
end union.tagged Maybe

fn first_even[$xs: List<Int>] -> Maybe<Int>:
    for $x in $xs:
        if $x mod.trunc 2 == 0:
            return Maybe.some[value = $x]
        end if
    end for
    return Maybe.nothing[]
end fn first_even

fn describe[$m: Maybe<Int>]:
    match $m:
        case some $s:
            println("found " $s.value as String)
        case nothing:
            println("none")
    end match
end fn describe

fn.main[]:
    describe(first_even([1, 3, 4, 5]))
    describe(first_even([1, 3]))
    let $word: Maybe<String> = Maybe.some[value = "hi"]
    if $word: Maybe.some:
        println($word.value)
    end if
end fn.main
